<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Raghav Gupta — Digital Marketing & Growth</title>
<style>
:root{--n:#10152B;--p:#F2A2C7;--t:#D8DCEC;--c:#1a2142}
*{box-sizing:border-box;margin:0}html{scroll-behavior:smooth}
body{background:var(--n);color:#fff;font:16px/1.6 system-ui,"Segoe UI",Arial,sans-serif;overflow-x:hidden}
a{color:var(--p)}:focus-visible{outline:3px solid var(--p);outline-offset:3px}
nav{position:fixed;top:0;left:0;right:0;z-index:20;display:flex;justify-content:space-between;align-items:center;padding:12px 5vw;background:#10152Bcc;backdrop-filter:blur(8px)}
nav b{letter-spacing:.1em}nav div{display:flex;gap:16px;font-size:14px}nav a{color:var(--t);text-decoration:none}nav a:hover{color:var(--p)}
nav div{overflow-x:auto;white-space:nowrap;scrollbar-width:none;max-width:78vw}nav div::-webkit-scrollbar{display:none}nav a[aria-current]{color:var(--p)}nav a.soon{opacity:.5;cursor:not-allowed}
#hero{position:relative;min-height:100vh;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;overflow:hidden;padding-top:70px}
#hero h1{position:absolute;top:13vh;width:100%;text-align:center;font-size:clamp(3rem,15vw,12rem);line-height:.9;font-weight:900;letter-spacing:-.04em;color:#fff}
#hero h1 span{display:block;color:var(--p)}
.sub{position:absolute;top:calc(13vh + clamp(6.5rem,31vw,25rem));width:100%;text-align:center;color:var(--t);z-index:1;padding:0 20px}
.stage{position:relative;width:min(92vw,980px);height:min(86vh,760px)}
.sticker{position:absolute;bottom:0;left:50%;width:min(62vw,330px);aspect-ratio:832/1352;margin-left:calc(min(62vw,330px)/-2);z-index:3;transform:translate(120vw,-70vh) rotate(50deg);visibility:hidden}.go .sticker{visibility:visible;animation:fly 1.5s cubic-bezier(.2,1.25,.4,1) forwards}
@keyframes fly{60%{transform:translate(0,0) rotate(-6deg)}to{transform:none}}
.fx{position:absolute;inset:0;filter:drop-shadow(3px 0 0 #fff) drop-shadow(-3px 0 0 #fff) drop-shadow(0 3px 0 #fff) drop-shadow(0 -3px 0 #fff) drop-shadow(2px 2px 0 #fff) drop-shadow(-2px -2px 0 #fff) drop-shadow(0 14px 14px #0009)}
.fx i{position:absolute;inset:0;background:url(data:image/png;base64,) center/100% 100% no-repeat}
.base{clip-path:inset(7.69% 0 0 0)}
.lid{clip-path:inset(0 0 calc(100% - 7.69%) 0);transform-origin:12% 7.69%;transition:transform .9s cubic-bezier(.3,1.5,.5,1)}
.open .lid{transform:rotate(-38deg) translate(-4%,-3%)}
.obj{position:absolute;left:50%;top:30%;z-index:2;opacity:0;transform:translate(-50%,-50%) scale(.1);transition:left 1s cubic-bezier(.2,1.3,.4,1),top 1s cubic-bezier(.2,1.3,.4,1),opacity .5s,transform 1s;transition-delay:var(--d);border:0;background:none;color:#fff;font:inherit;cursor:pointer}
.out .obj{left:var(--l);top:var(--t);opacity:1;transform:translate(-50%,-50%) scale(1)}
.obj>span{display:flex;flex-direction:column;align-items:center;gap:4px;padding:10px 14px;border-radius:18px;background:var(--c);border:2px solid var(--col);box-shadow:0 10px 24px #0008,0 0 0 4px #ffffff10;animation:fl 4s ease-in-out infinite;animation-delay:var(--d);transition:transform .25s,background .25s;font-size:12px;font-weight:700;white-space:nowrap}
.obj b{font-size:clamp(1.4rem,4vw,2.2rem);line-height:1}
.obj:hover>span,.obj:focus-visible>span{transform:scale(1.18) rotate(-4deg);background:var(--col);color:var(--n)}
@keyframes fl{50%{translate:0 -10px}}
.obj b{display:grid;place-items:center;width:38px;height:38px;border-radius:50%;background:var(--col);color:var(--n);font-size:1.1rem;font-weight:900}
.obj b svg{width:22px;height:22px;display:block}.obj b.w{background:#fff}.obj b.p{background:var(--p)}@media(max-width:700px){.obj b svg{width:17px;height:17px}}
.ov{position:fixed;inset:0;z-index:50;background:#0a0d1ecc;backdrop-filter:blur(6px);display:flex;align-items:center;justify-content:center;padding:16px;opacity:0;visibility:hidden;transition:opacity .3s,visibility .3s}.ov.show{opacity:1;visibility:visible}
.pn{position:relative;width:min(100%,640px);max-height:86vh;overflow:auto;background:var(--c);border:1px solid #ffffff22;border-radius:22px;padding:30px 26px 26px;transform:translateY(24px) scale(.97);transition:transform .35s cubic-bezier(.2,1.1,.4,1)}.show .pn{transform:none}
.pn h3{font-size:clamp(1.8rem,6vw,2.6rem);line-height:1.05;margin-bottom:6px;padding-right:44px}.pn h3 em{color:var(--p);font-style:normal}.pn p,.pn li{color:var(--t)}.pn li{margin:4px 0}.pn ul{padding-left:20px}
.pn h4{color:var(--p);margin:18px 0 6px;font-size:.78rem;letter-spacing:.14em;text-transform:uppercase}
.x{position:absolute;top:14px;right:14px;width:38px;height:38px;border-radius:50%;border:0;background:var(--p);color:var(--n);font-size:20px;font-weight:900;cursor:pointer}
.tl{border-left:3px solid var(--p);padding:2px 0 2px 16px;margin:0 0 18px}.tl b{display:block;font-size:1.05rem}.tl small{display:block;color:var(--p);font-weight:700}.tl span{color:var(--t)}
@media(max-width:700px){.out .obj{left:var(--lm);top:var(--tm)}.obj>span{padding:6px 9px;font-size:11px;gap:2px}.obj b{width:28px;height:28px;font-size:.95rem}}
body.ld{overflow:hidden}
#load{position:fixed;inset:0;z-index:100;background:var(--n);display:flex;flex-direction:column;align-items:center;justify-content:center;transition:opacity .6s,visibility .6s}#load.off{opacity:0;visibility:hidden}
#cnt{font-size:clamp(6rem,30vw,16rem);font-weight:900;line-height:1;letter-spacing:-.05em;font-variant-numeric:tabular-nums}
.lb{width:min(70vw,360px);height:6px;border-radius:9px;background:#ffffff1f;margin-top:18px;overflow:hidden}#bar{height:100%;width:0;background:var(--p)}
#load p{margin-top:12px;color:var(--t);letter-spacing:.3em;font-size:12px;text-transform:uppercase}
.cc{display:inline-flex;align-items:center;gap:12px;margin:8px 12px 0 0;padding:12px 20px;border-radius:99px;background:var(--c);border:1px solid #ffffff26;color:#fff;text-decoration:none;font-weight:700;transition:transform .25s,border-color .25s}.cc:hover,.cc:focus-visible{transform:translateY(-3px);border-color:var(--p)}
.cc i{display:grid;place-items:center;width:38px;height:38px;border-radius:50%;background:var(--p);color:var(--n);flex:none}.cc svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.cc small{display:block;color:var(--t);font-weight:400;font-size:12px;line-height:1.2}.cc span{overflow-wrap:anywhere}
footer a{color:var(--t);text-decoration:none;overflow-wrap:anywhere}footer a:hover{color:var(--p)}
@media(max-width:480px){.cc{font-size:14px;padding:10px 14px}.cc span{overflow-wrap:normal}}footer{padding-bottom:90px}
.hint{position:absolute;bottom:10px;right:5vw;z-index:4;color:var(--t);font-size:13px}
section{padding:14vh 6vw 8vh;max-width:1200px;margin:auto}
section h2{font-size:clamp(2.2rem,8vw,6rem);line-height:1;letter-spacing:-.03em;margin-bottom:.4em}section h2 em{color:var(--p);font-style:normal}
.big{font-size:clamp(1.4rem,3.6vw,2.6rem);line-height:1.3;font-weight:700}.big mark{background:none;color:var(--p)}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px;margin-top:24px}
.card{background:var(--c);border:1px solid #ffffff1a;border-radius:18px;padding:20px;color:var(--t);transition:transform .3s,border-color .3s}.card:hover{transform:translateY(-4px);border-color:var(--p)}
.card h3{color:#fff;margin-bottom:6px}.tag{display:inline-block;background:var(--p);color:var(--n);font-size:12px;font-weight:800;padding:2px 10px;border-radius:99px;margin-bottom:10px}
.ph{border:2px dashed #ffffff40;border-radius:18px;padding:30px;text-align:center;color:var(--t);margin-top:16px}
.rv{opacity:0;transform:translateY(40px);transition:1s}.rv.in{opacity:1;transform:none}
section.hl h2{animation:pk 1.2s}@keyframes pk{30%{color:var(--p)}}
details{background:var(--c);border-left:4px solid var(--p);border-radius:0 14px 14px 0;padding:14px 18px;margin:0 0 16px 14px}summary{cursor:pointer;font-weight:800;font-size:1.2rem}summary small{display:block;color:var(--p);font-weight:600}details p{color:var(--t);margin-top:8px}
.cta{display:inline-block;margin:6px 10px 0 0;padding:12px 22px;border-radius:99px;background:var(--p);color:var(--n);font-weight:800;text-decoration:none}
#top{position:fixed;right:18px;bottom:18px;z-index:20;border:0;border-radius:99px;padding:12px 18px;background:var(--p);color:var(--n);font-weight:800;cursor:pointer;display:none}
footer{text-align:center;color:var(--t);padding:30px;font-size:13px}
@media(prefers-reduced-motion:reduce){*{animation-duration:.01s!important;transition-duration:.01s!important;transition-delay:0s!important}html{scroll-behavior:auto}}
</style></head><body class="ld">
<div id="load" role="status" aria-label="Loading"><div id="cnt">1</div><div class="lb"><div id="bar"></div></div><p>Loading</p></div>
<nav><b>RG</b><div><a href="index.html#hero" aria-current="page">Portfolio</a><a href="meta-ads-standalone.html">Meta Ads</a><a class="soon" aria-disabled="true">Creatives (soon)</a><a href="#about">About</a><a href="#experience">Experience</a><a href="#contact">Contact</a></div></nav>
<header id="hero"><h1>RAGHAV<span>GUPTA</span></h1><p class="sub"><b>Digital Marketing &amp; Growth</b><br>Turning Marketing Ideas Into Meaningful Growth.</p>
<div class="stage" id="stage"><div class="sticker" role="img" aria-label="Portrait of Raghav Gupta"><div class="fx" id="fx"><i class="base"></i><i class="lid"></i>
</div></div></div>
</header>

<section id="about" class="rv"><h2>About <em>me</em></h2><p class="big">I'm Raghav Gupta, a digital marketing professional interested in <mark>performance advertising</mark>, <mark>growth marketing</mark>, <mark>CRM</mark> and <mark>marketing analytics</mark>. I enjoy learning how campaigns work, exploring marketing automation and using data to make better marketing decisions.</p></section>
<section id="experience" class="rv"><h2>Experi<em>ence</em></h2><div id="exl"></div></section>
<section id="contact" class="rv"><h2>CONTACT <em>ME</em></h2><p style="color:var(--t);margin-bottom:12px">Let's build something great together.</p>
<a class="cc" href="mailto:raghavgupta2090@gmail.com"><i><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></i><span><small>Email</small>raghavgupta2090@gmail.com</span></a>
<a class="cc" href="tel:+919410070772"><i><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg></i><span><small>Phone</small>+91 9410070772</span></a>
<a class="cc" href="https://linkedin.com/in/raghav-gupta-a5a648284/" target="_blank" rel="noopener noreferrer"><i><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10v7M7 7v.01M11 17v-4a2.5 2.5 0 0 1 5 0v4M11 10v7"/><rect x="3" y="3" width="18" height="18" rx="3"/></svg></i><span><small>LinkedIn</small>Raghav Gupta ↗</span></a></section>
<footer><div style="display:flex;flex-wrap:wrap;justify-content:center;gap:4px 18px"><a href="mailto:raghavgupta2090@gmail.com">raghavgupta2090@gmail.com</a><a href="tel:+919410070772">+91 9410070772</a><a href="https://linkedin.com/in/raghav-gupta-a5a648284/" target="_blank" rel="noopener noreferrer">LinkedIn</a></div><div style="margin-top:6px">© Raghav Gupta · Digital Marketing &amp; Growth</div></footer>
<button id="top" aria-label="Back to hero">↑ Hero</button>
<script>
(function(){
// ===== EDIT CONTENT HERE (only facts you can support; no invented results) =====
var EXP=[["Growth Marketing Executive — Smartkeeda","June 2026 – Present","Working on growth marketing activities, marketing data, campaign-related tasks and exposure to marketing automation."],
["Digital Marketing Intern — PingMedia","April 2026 – May 2026","Gained practical exposure to growth marketing, marketing data filtering and campaign-related tasks."],
["Computer Teacher — AVC Education","March 2025 – May 2026","Taught MS Word, Excel, PowerPoint, Tally Prime and CorelDRAW."]];
var M={
meta:["Meta <em>Ads</em>","Motion Academy internship, Jan–Jun 2026","<p>During my internship at Motion Academy I worked on Meta advertising, focused on lead generation, and practised campaigns for Agra, Firozabad, Mathura and nearby areas.</p><h4>What I work with</h4><ul><li><b>Lead generation:</b> campaigns built to collect enquiries.</li><li><b>Audience targeting:</b> choosing location, interests and demographics.</li><li><b>CTR</b> (click-through rate): clicks ÷ impressions.</li><li><b>CPC</b> (cost per click): spend ÷ clicks.</li><li><b>CPL</b> (cost per lead): spend ÷ leads.</li></ul>"],
google:["Google <em>Ads</em>","Learning-focused","<h4>Skills I have learned</h4><ul><li>Campaign setup and structure</li><li>Keyword research</li><li>Ad formats (Search, Display and others)</li><li>Conversion setup and performance tracking</li></ul><h4>Work I have independently executed</h4><p>No independent live Google Ads campaigns are claimed here. My knowledge is from learning and practice; real campaign work will be added when available.</p>"],
crm:["CRM","Smartkeeda — exposure","<p>At Smartkeeda I have exposure to marketing automation and CRM workflows, including Netcore, and to marketing communication channels such as email, SMS, push notifications and WhatsApp.</p><h4>Level</h4><p>This is working exposure and ongoing learning, not advanced expertise or independent campaign ownership.</p>"],
experience:["Experi<em>ence</em>","My professional journey",""]};
var tl=EXP.map(function(x){return'<div class="tl"><b>'+x[0]+'</b><small>'+x[1]+'</small><span>'+x[2]+'</span></div>'}).join("");
M.experience[2]=tl;document.getElementById("exl").innerHTML=tl;
// ===============================================================================
var IC={
meta:["w",'<svg viewBox="0 0 256 256" aria-hidden="true"><path fill="#0866FF" d="M240 149.31c0 16.11-3.17 29.89-9.17 39.84c-7.43 12.33-19 18.85-33.39 18.85c-27.94 0-47.78-37-68.78-76.22C111.64 100 92.35 64 74 64c-9.38 0-19.94 10-28.25 26.67A138.2 138.2 0 0 0 32 149.31c0 13.2 2.38 24.12 6.88 31.58S49.82 192 58.56 192c15.12 0 30.85-24.54 44.23-48.55a8 8 0 0 1 14 7.8C101.46 178.71 83.07 208 58.56 208c-14.41 0-26-6.52-33.39-18.85c-6-10-9.17-23.73-9.17-39.84a154.8 154.8 0 0 1 15.42-65.77C42.82 60.62 57.94 48 74 48c27.94 0 47.77 37 68.78 76.22C159.79 156 179.08 192 197.44 192c8.74 0 15.18-3.63 19.68-11.11s6.88-18.38 6.88-31.58a138.2 138.2 0 0 0-13.74-58.64C202 74 191.39 64 182 64c-8.36 0-17.68 7.48-28.51 22.88a8 8 0 1 1-13.08-9.21c9-12.74 23-29.67 41.59-29.67c16.05 0 31.17 12.62 42.57 35.54A154.8 154.8 0 0 1 240 149.31"/></svg>'],
google:["w",'<svg viewBox="0 0 256 230" aria-hidden="true"><path fill="#FBBC04" d="M5.888 166.405L90.88 20.9c10.796 6.356 65.236 36.484 74.028 42.214L79.916 208.627c-9.295 12.28-85.804-23.587-74.028-42.23z"/><path fill="#4285F4" d="M250.084 166.402L165.092 20.906C153.21 1.132 127.62-6.054 106.601 5.625S79.182 42.462 91.064 63.119l84.992 145.514c11.882 19.765 37.473 26.95 58.492 15.272c20.1-11.68 27.418-37.73 15.536-57.486z"/><ellipse cx="42.664" cy="187.924" fill="#34A853" rx="42.664" ry="41.604"/></svg>'],
crm:["p",'<svg viewBox="0 0 24 24" aria-hidden="true"><g stroke="#10152B" stroke-width="1.8" stroke-linecap="round"><path d="M6.5 6.5h11M6.5 6.5L12 17.5M17.5 6.5L12 17.5"/></g><g fill="#10152B"><circle cx="6" cy="6" r="2.6"/><circle cx="18" cy="6" r="2.6"/><circle cx="12" cy="18" r="2.6"/></g></svg>'],
creative:["p",'<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="#10152B" stroke-width="1.9" stroke-linejoin="round" d="M12 3a9 9 0 1 0 0 18c1.1 0 1.8-.9 1.8-1.8 0-.5-.2-.9-.5-1.3-.3-.3-.5-.8-.5-1.3 0-1 .8-1.8 1.8-1.8H16a5 5 0 0 0 5-5c0-4.4-4-7.8-9-7.8z"/><g fill="#10152B"><circle cx="7.6" cy="11" r="1.2"/><circle cx="10.4" cy="7.3" r="1.2"/><circle cx="15" cy="7.6" r="1.2"/></g></svg>']};
var O=[["meta","M","Meta Ads","#8fb4ff","27%","14%","13%","40%"],["google","G","Google Ads","#F2A2C7","14%","34%","13%","52%"],["crm","C","CRM","#ffd27a","73%","14%","87%","40%"],["creative","Cr","Creative","#9fe3ff","86%","34%","87%","52%"]];
var st=document.getElementById("stage"),last=null;
var ov=document.createElement("div");ov.className="ov";ov.innerHTML='<div class="pn" role="dialog" aria-modal="true" aria-labelledby="mt"><button class="x" aria-label="Close">×</button><h3 id="mt"></h3><small style="color:var(--p);font-weight:700" id="ms"></small><div id="mb"></div></div>';document.body.appendChild(ov);
var xb=ov.querySelector(".x");
function openM(k){var m=M[k];last=document.activeElement;document.getElementById("mt").innerHTML=m[0];document.getElementById("ms").textContent=m[1];document.getElementById("mb").innerHTML=m[2];ov.querySelector(".pn").scrollTop=0;ov.classList.add("show");document.body.style.overflow="hidden";xb.focus()}
function closeM(){ov.classList.remove("show");document.body.style.overflow="";if(last)last.focus()}
xb.onclick=closeM;ov.addEventListener("click",function(e){if(e.target===ov)closeM()});
document.addEventListener("keydown",function(e){if(!ov.classList.contains("show"))return;if(e.key==="Escape")closeM();if(e.key==="Tab"){e.preventDefault();xb.focus()}});
O.forEach(function(o,i){var b=document.createElement("button");b.className="obj";b.setAttribute("aria-label","Open "+o[2]);
b.style.cssText="--col:"+o[3]+";--l:"+o[4]+";--t:"+o[5]+";--lm:"+o[6]+";--tm:"+o[7]+";--d:"+(i*.15)+"s";b.innerHTML="<span><b class=\""+IC[o[0]][0]+"\">"+IC[o[0]][1]+"</b>"+o[2]+"</span>";
b.onclick=function(){if(o[0]==="creative"){location.href="creative-standalone.html"}else{openM(o[0])}};st.appendChild(b)});
var rm=matchMedia("(prefers-reduced-motion:reduce)").matches;
var D=rm?400:3600,cnt=document.getElementById("cnt"),bar=document.getElementById("bar"),t0=null;
function tick(n){if(t0===null)t0=n;var p=Math.min((n-t0)/D,1),v=Math.max(1,Math.round((.5-Math.cos(p*Math.PI)/2)*100));cnt.textContent=v;bar.style.width=v+"%";if(p<1)requestAnimationFrame(tick);else finish()}
function finish(){setTimeout(function(){document.getElementById("load").classList.add("off");document.body.classList.remove("ld");
setTimeout(function(){st.classList.add("go")},rm?0:500);
setTimeout(function(){st.classList.add("open");document.getElementById("fx").classList.add("open")},rm?50:2400);
setTimeout(function(){st.classList.add("out")},rm?100:3000)},250)}
requestAnimationFrame(tick);
// reveal + back button
var io=new IntersectionObserver(function(a){a.forEach(function(x){if(x.isIntersecting)x.target.classList.add("in")})},{threshold:.1});
document.querySelectorAll(".rv").forEach(function(e){io.observe(e)});
var tb=document.getElementById("top");addEventListener("scroll",function(){tb.style.display=scrollY>innerHeight*.6?"block":"none"});
tb.onclick=function(){scrollTo({top:0,behavior:"smooth"})};
})();
</script></body></html>
